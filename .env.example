# LLM (OpenAI-compatible). Hermes already has these in ~/.hermes/.env —
# this project auto-loads that file if present.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://llm.lintware.com/v1
PAINPOINT_MODEL=grok-4.5

# Optional Reddit OAuth (script or installed app) — preferred when available.
# Create at https://www.reddit.com/prefs/apps  →  type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=macos:painpoint-ai:0.1.0 (by /u/YOUR_USERNAME)
# Only needed for password-grant script apps:
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Data source: arctic (default, no Reddit key) | praw | demo
PAINPOINT_SOURCE=arctic
